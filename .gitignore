# Godot editor cache and local import files
.godot/
*.import

# The supplied distribution.json explicitly excludes these local-study assets
# from public distribution. Keep the originals locally, outside Git history.
/addons/hd2d_scene_tools/assets/local_study_characters/

# Local projects, generated content, and release archives
/project.godot
/hd2d_generated/
/hd2d_imports/
/dist/
*.zip
*.log

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
__pycache__/

# Bundled import settings are part of reproducible weather/sky rendering
!addons/hd2d_scene_tools/assets/weather/*.png.import
!addons/hd2d_scene_tools/third_party/sky3d/**/*.import

# Never distribute local QA or optional library projects
/local_tests/
/tests/
/qa/
/case*/
/showcase/
/local_study/
/HD2D_Shared_Asset_Library/
